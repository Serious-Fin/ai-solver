FROM node:latest
WORKDIR /app
COPY package*.json ./

ENV DISCORD_TOKEN=$DISCORD_TOKEN
ENV DISCORD_CHANNEL_ID=$DISCORD_CHANNEL_ID
ENV GOOGLE_OAUTH_CLIENT_SECRET=$GOOGLE_OAUTH_CLIENT_SECRET
ENV GITHUB_OAUTH_CLIENT_SECRET=$GITHUB_OAUTH_CLIENT_SECRET

RUN npm ci
COPY . .
RUN npx svelte-kit sync
RUN npm run build
EXPOSE 3000
CMD ["node", "build"]